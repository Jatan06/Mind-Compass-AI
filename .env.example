# ===================================================
# Mind Compass AI - Single Unified Environment Template
# ===================================================

# --- Django Backend Settings ---
DEBUG=True
SECRET_KEY=django-insecure-your-development-only-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database Settings ---
DB_NAME=MindCompass
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_HOST=localhost
DB_PORT=5432

# --- CORS & Frontend Connection ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://127.0.0.1:8000

# --- Google OAuth Credentials ---
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Redis & Celery Settings ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Email SMTP Configuration ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL=MindCompass <your_email@gmail.com>
# --- Gemini AI (for AI Companion chatbot) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Groq AI (for AI Companion chatbot) ---
GROQ_API_KEY=your-groq-api-key-here
